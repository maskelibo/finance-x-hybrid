{
  "name": "finance-x-hybrid",
  "private": true,
  "type": "module",
  "description": "Finance X — BIST şirketleri için 22 ajanlı kurumsal araştırma orkestrasyonu",
  "scripts": {
    "dev": "cd backend && npx tsx src/server.ts",
    "dev:server": "cd backend && npx tsx src/server.ts",
    "dev:dashboard": "cd dashboard && npm run dev",
    "dev:all": "cd backend && npx tsx src/server.ts & cd dashboard && npm run dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "cd backend && npm test",
    "test:run": "cd backend && npm test",
    "schemas:regen": "cd backend && npm run schemas:regen"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "dependencies": {
    "pdf-parse": "^2.4.5"
  }
}
