   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Countless modern server cabinets in a render farm corridor. Dark, sci-fi, futuristic room with a glossy floor. State of the art technology. Network node cluster connection. High angle camera view.</rdf:li>
    </rdf:Alt>
   </dc:description>
