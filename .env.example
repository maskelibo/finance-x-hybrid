# ============================================================
# Finance-X Hybrid — Environment Variables (R2: config.ts + master spec derlemesi)
# Kullanım: bu dosyayı `.env` olarak kopyala, secret alanları doldur.
# ============================================================

# -- Core LLM / Claude --
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_LIGHT=claude-haiku-4-5
CLAUDE_OUTPUT_FORMAT=stream-json
CLAUDE_PERMISSION_MODE=bypassPermissions
CLAUDE_PATH=

# -- LLM routing (legacy) --
LLM_PRIMARY_PROVIDER=claude
LLM_FALLBACK_PROVIDER=codex

# -- Server --
PORT=4000
FINANCE_X_ROOT=
FINANCE_X_ALLOWED_ORIGINS=

# -- Context / Digest --
CONTEXT_CHAR_LIMIT=15000
DIGEST_MODE=true
TARGETED_KNOWLEDGE_INJECTION=true
UPSTREAM_DIGEST_MODE=smart

# -- Core feature flags --
FINANCIAL_ENGINE_ENABLED=true
REPORT_PAYLOAD_MODE=true
FORMATTER_MINIMAL_CONTEXT=true
OPTIMIZED_PIPELINE=true
REGRESSION_EVAL_ENABLED=true
BYPASS_CEO_FOR_TESTS=false

# -- Schema validation --
SCHEMA_VALIDATION_MODE=warn
SCHEMA_SOFT_BLOCK_AGENTS=financial_analysis,reconciliation,valuation_agent,sector_competition,strategic_synthesis

# -- QA checklist --
CHECKLIST_ENFORCEMENT_MODE=warn
CHECKLIST_MIN_ADDRESSAL_RATE=0.85

# -- Timeouts / Stall --
STUCK_AGENT_THRESHOLD_MS=1500000
PROVIDER_STALL_TIMEOUT_S=1800

# -- Heartbeats / Watchdog --
HEARTBEAT_INTERVAL_MIN=30
WATCHDOG_INTERVAL_MIN=2
NIGHT_TRAINING_HOUR_UTC=23

# ============================================================
# Python hybrid pipeline (Wave 9 — 20 per-agent flags)
# R2: default'lar true'ya çekildi. Per-agent rollback için tek tek false yapılabilir.
# ============================================================
PYTHON_PIPELINE_ENABLED=true
PYTHON_KAP_WATCH_ENABLED=true
PYTHON_DATA_COLLECTION_ENABLED=true
PYTHON_PARSE_STANDARDIZATION_ENABLED=true
PYTHON_RECONCILIATION_ENABLED=true
PYTHON_FINANCIAL_ANALYSIS_ENABLED=true
PYTHON_TECHNICAL_ANALYSIS_ENABLED=true
PYTHON_TECHNICAL_BARS=250
PYTHON_MACRO_ANALYSIS_ENABLED=true
PYTHON_ANALYST_CONSENSUS_ENABLED=true
PYTHON_SENTIMENT_NEWS_ENABLED=true
PYTHON_ESG_ENABLED=true
PYTHON_EVENT_CLASSIFICATION_ENABLED=true
PYTHON_EVENT_IMPACT_MAPPER_ENABLED=true
PYTHON_EVENT_TIMELINE_ALERT_ENABLED=true
PYTHON_VALUATION_ENABLED=true
PYTHON_STRATEGIC_SYNTHESIS_ENABLED=true
PYTHON_QA_REVIEW_ENABLED=true
PYTHON_COO_ENABLED=true
PYTHON_REPORT_FORMATTER_ENABLED=true
PYTHON_SECTOR_COMPETITION_ENABLED=true

# ============================================================
# External data providers (Block U için placeholder'lar — master spec)
# ============================================================
EVDS_API_KEY=
NEWSAPI_KEY=
OPENAI_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
DOCUMENT_INTEL_ENABLED=false
SKILLS_ENABLED=false

# -- Logging --
LOG_LEVEL=info
LOG_FORMAT=pretty

# ============================================================
# Sub-Agent Feature Flags (Part 2 / Block S — default OFF for shadow mode)
# Each flag unlocks the sub-agent path for one parent agent after its
# S-phase promotion gate clears. SUBAGENT_SHADOW_MODE=true runs the
# sub-agents alongside the legacy agent for comparison without taking
# the sub-agent output as authoritative.
# ============================================================
SUBAGENT_DATA_COLLECTION_ENABLED=false
SUBAGENT_PARSE_STD_ENABLED=false
SUBAGENT_FINANCIAL_ANALYSIS_ENABLED=false
SUBAGENT_REPORT_FORMATTER_ENABLED=false
SUBAGENT_MACRO_ANALYSIS_ENABLED=false
SUBAGENT_VALUATION_ENABLED=false
SUBAGENT_SECTOR_COMPETITION_ENABLED=false
SUBAGENT_EVENT_IMPACT_ENABLED=false
SUBAGENT_FINAL_SUMMARY_ENABLED=false
SUBAGENT_STRATEGIC_SYNTHESIS_ENABLED=false
SUBAGENT_SHADOW_MODE=false
