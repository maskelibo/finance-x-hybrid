{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://financex.io/schemas/agents/macro_analysis/output",
  "title": "Macro Analysis Agent Output Schema",
  "type": "object",
  "required": ["agent_id", "output_id", "session_id", "task_id", "timestamp", "company", "macro_environment", "confidence_overall", "warnings", "review_status"],
  "properties": {
    "agent_id": { "type": "string", "const": "macro_analysis" },
    "output_id": { "type": "string" },
    "session_id": { "type": "string" },
    "task_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "company": { "type": "object" },
    "macro_environment": {
      "type": "object",
      "properties": {
        "monetary_policy": {
          "type": "object",
          "properties": {
            "tcmb_policy_rate_pct": { "type": "number" },
            "rate_trend": { "type": "string", "enum": ["tightening", "easing", "stable"] },
            "last_4_decisions": { "type": "array", "items": { "type": "object" } },
            "source": { "type": "string" },
            "data_date": { "type": "string" }
          }
        },
        "inflation": {
          "type": "object",
          "properties": {
            "cpi_yoy_pct": { "type": "number" },
            "ppi_yoy_pct": { "type": "number" },
            "trend": { "type": "string" },
            "source": { "type": "string" },
            "data_date": { "type": "string" }
          }
        },
        "currency": {
          "type": "object",
          "properties": {
            "try_usd": { "type": "number" },
            "try_eur": { "type": "number" },
            "ytd_change_pct": { "type": "number" },
            "12m_change_pct": { "type": "number" },
            "source": { "type": "string" },
            "data_date": { "type": "string" }
          }
        },
        "growth": {
          "type": "object",
          "properties": {
            "gdp_growth_yoy_pct": { "type": "number" },
            "latest_quarter": { "type": "string" },
            "source": { "type": "string" }
          }
        },
        "credit": {
          "type": "object",
          "properties": {
            "sector_credit_growth_yoy_pct": { "type": "number" },
            "commercial_borrowing_cost_pct": { "type": "number" },
            "source": { "type": "string" }
          }
        }
      }
    },
    "company_macro_linkages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["macro_variable", "company_channel", "impact_direction", "confidence", "explanation"],
        "properties": {
          "macro_variable": { "type": "string" },
          "company_channel": { "type": "string" },
          "impact_direction": { "type": "string", "enum": ["positive", "negative", "mixed", "uncertain"] },
          "confidence": { "type": "string", "enum": ["high", "medium", "low", "speculative"] },
          "explanation": { "type": "string" },
          "evidence_basis": { "type": "string" }
        }
      }
    },
    "evidence_refs": { "type": "array", "items": { "type": "object" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "missing_inputs": { "type": "array", "items": { "type": "string" } },
    "confidence_overall": { "type": "string", "enum": ["high", "medium", "low", "speculative"] },
    "contradictions_detected": { "type": "array", "items": { "type": "object" } },
    "review_status": { "type": "string", "enum": ["pending_ceo_review", "approved", "rejected", "revision_requested"] }
  },
  "additionalProperties": false
}
