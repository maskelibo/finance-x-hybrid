{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://financex.io/schemas/agents/qa_review/output",
  "title": "QA Review Agent Output Schema",
  "type": "object",
  "required": ["agent_id", "output_id", "session_id", "reviewed_output_id", "producing_agent_id", "qa_decision", "dimension_scores", "quality_flags", "escalation_recommendation", "review_timestamp"],
  "properties": {
    "agent_id": { "type": "string", "const": "qa_review" },
    "output_id": { "type": "string" },
    "session_id": { "type": "string" },
    "reviewed_output_id": { "type": "string" },
    "producing_agent_id": { "type": "string" },
    "qa_decision": { "type": "string", "enum": ["pass", "conditional_pass", "fail"] },
    "dimension_scores": {
      "type": "object",
      "required": ["evidence_sufficiency", "confidence_calibration", "claim_support", "completeness", "scope_compliance"],
      "properties": {
        "evidence_sufficiency": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "confidence_calibration": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "claim_support": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "completeness": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "scope_compliance": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "overall_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["flag_type", "severity", "description"],
        "properties": {
          "flag_type": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "description": { "type": "string" },
          "affected_claim": { "type": "string" }
        }
      }
    },
    "cross_reference_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_type", "description"],
        "properties": {
          "finding_type": { "type": "string" },
          "description": { "type": "string" },
          "conflicting_output_id": { "type": "string" }
        }
      }
    },
    "escalation_recommendation": {
      "type": "string",
      "enum": ["none", "escalate_to_ceo", "deep_review_required"]
    },
    "review_timestamp": { "type": "string", "format": "date-time" },
    "review_notes": { "type": "string" }
  },
  "additionalProperties": false
}
