{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://financex.io/schemas/agents/valuation_agent/output",
  "title": "Valuation Agent Output Schema",
  "type": "object",
  "required": ["agent_id", "output_id", "session_id", "task_id", "timestamp", "company", "dcf", "multiples", "scenarios", "fair_value", "confidence_overall", "warnings", "review_status"],
  "properties": {
    "agent_id": { "type": "string", "const": "valuation_agent" },
    "output_id": { "type": "string" },
    "session_id": { "type": "string" },
    "task_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "company": {
      "type": "object",
      "required": ["ticker"],
      "properties": {
        "name": { "type": "string" },
        "ticker": { "type": "string" }
      }
    },
    "dcf": {
      "type": "object",
      "required": ["wacc", "terminal_growth", "fair_value_per_share"],
      "properties": {
        "wacc": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "cost_of_equity": { "type": ["number", "null"] },
        "cost_of_debt": { "type": ["number", "null"] },
        "terminal_growth": { "type": ["number", "null"] },
        "forecast_years": { "type": "integer", "minimum": 1 },
        "explicit_forecast_period_fcf": { "type": "array", "items": { "type": "number" } },
        "terminal_value": { "type": ["number", "null"] },
        "enterprise_value": { "type": ["number", "null"] },
        "equity_value": { "type": ["number", "null"] },
        "fair_value_per_share": { "type": ["number", "null"] },
        "currency": { "type": "string" },
        "sensitivity": {
          "type": "object",
          "properties": {
            "wacc_range": { "type": "array", "items": { "type": "number" } },
            "terminal_growth_range": { "type": "array", "items": { "type": "number" } },
            "fair_value_matrix": { "type": "array" }
          }
        }
      }
    },
    "multiples": {
      "type": "object",
      "properties": {
        "ev_ebitda": { "type": ["number", "null"] },
        "ev_sales": { "type": ["number", "null"] },
        "p_e": { "type": ["number", "null"] },
        "p_b": { "type": ["number", "null"] },
        "ev_ebitda_peer_median": { "type": ["number", "null"] },
        "p_e_peer_median": { "type": ["number", "null"] },
        "relative_assessment": {
          "type": "string",
          "enum": ["cheap", "fair", "expensive", "mixed", "unknown"]
        }
      }
    },
    "scenarios": {
      "type": "object",
      "required": ["bear", "base", "bull"],
      "properties": {
        "bear": {
          "type": "object",
          "required": ["target_price", "probability"],
          "properties": {
            "target_price": { "type": ["number", "null"] },
            "probability": { "type": "number", "minimum": 0, "maximum": 1 },
            "triggers": { "type": "array", "items": { "type": "string" } },
            "narrative": { "type": "string" }
          }
        },
        "base": {
          "type": "object",
          "required": ["target_price", "probability"],
          "properties": {
            "target_price": { "type": ["number", "null"] },
            "probability": { "type": "number", "minimum": 0, "maximum": 1 },
            "assumptions": { "type": "array", "items": { "type": "string" } },
            "narrative": { "type": "string" }
          }
        },
        "bull": {
          "type": "object",
          "required": ["target_price", "probability"],
          "properties": {
            "target_price": { "type": ["number", "null"] },
            "probability": { "type": "number", "minimum": 0, "maximum": 1 },
            "triggers": { "type": "array", "items": { "type": "string" } },
            "narrative": { "type": "string" }
          }
        }
      }
    },
    "fair_value": {
      "type": "object",
      "required": ["method", "value_per_share", "currency"],
      "properties": {
        "method": { "type": "string", "enum": ["dcf", "multiples", "sotp", "blended"] },
        "value_per_share": { "type": ["number", "null"] },
        "currency": { "type": "string" },
        "upside_downside_pct": { "type": ["number", "null"] }
      }
    },
    "try_risk_note": { "type": "string" },
    "document_evidence_citations": {
      "type": "array",
      "description": "U6: Citations tied to document_evidence for valuation assumptions (capex plans, strategic moves, guidance backing DCF inputs).",
      "items": {
        "type": "object",
        "required": ["claim", "doc_id", "page"],
        "properties": {
          "claim": { "type": "string" },
          "doc_id": { "type": "string" },
          "page": { "type": "integer" },
          "snippet_excerpt": { "type": "string", "maxLength": 400 },
          "relevance": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "confidence_overall": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW", "BLOCKED"]
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "review_status": {
      "type": "string",
      "enum": ["ready", "needs_revision"]
    }
  }
}
