{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://financex.io/schemas/agents/context_extraction/output",
  "title": "Context Extraction Agent Output Schema",
  "type": "object",
  "required": ["agent_id", "output_id", "session_id", "task_id", "timestamp", "company", "company_profile", "confidence_overall", "warnings", "review_status"],
  "properties": {
    "agent_id": { "type": "string", "const": "context_extraction" },
    "output_id": { "type": "string" },
    "session_id": { "type": "string" },
    "task_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "company": { "type": "object" },
    "company_profile": {
      "type": "object",
      "properties": {
        "legal_name": { "type": "string" },
        "ticker": { "type": "string" },
        "bist_sector": { "type": "string" },
        "controlling_shareholder": { "type": "string" },
        "business_description": { "type": "string" },
        "operating_segments": { "type": "array", "items": { "type": "object" } },
        "geographic_exposure": { "type": "string" }
      }
    },
    "operational_context": {
      "type": "object",
      "properties": {
        "capacity": { "type": "string" },
        "capacity_utilization_pct": { "type": ["number", "null"] },
        "key_cost_drivers": { "type": "array", "items": { "type": "string" } },
        "fx_exposure": { "type": "object" },
        "seasonality": { "type": "string" }
      }
    },
    "accounting_policy_context": {
      "type": "object",
      "properties": {
        "revenue_recognition_method": { "type": "string" },
        "inflation_accounting_applied": { "type": "boolean" },
        "key_estimates": { "type": "array", "items": { "type": "string" } },
        "consolidation_changes": { "type": "array", "items": { "type": "string" } },
        "auditor_qualifications": { "type": "array", "items": { "type": "string" } }
      }
    },
    "strategic_initiatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "disclosed_amount": { "type": "string" },
          "timeline": { "type": "string" },
          "source_document_id": { "type": "string" }
        }
      }
    },
    "management_guidance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "guidance_text", "source_document_id", "is_management_guidance"],
        "properties": {
          "metric": { "type": "string" },
          "guidance_text": { "type": "string" },
          "source_document_id": { "type": "string" },
          "is_management_guidance": { "type": "boolean", "const": true }
        }
      }
    },
    "evidence_refs": { "type": "array", "items": { "type": "object" } },
    "document_evidence_citations": {
      "type": "array",
      "description": "U6: Citations tied to document_evidence agent output. Map each qualitative claim (mgmt commentary summary, segment color, strategy) to doc_id + page.",
      "items": {
        "type": "object",
        "required": ["claim", "doc_id", "page"],
        "properties": {
          "claim": { "type": "string" },
          "doc_id": { "type": "string" },
          "page": { "type": "integer" },
          "snippet_excerpt": { "type": "string", "maxLength": 400 },
          "relevance": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "missing_inputs": { "type": "array", "items": { "type": "string" } },
    "confidence_overall": { "type": "string", "enum": ["high", "medium", "low", "speculative"] },
    "review_status": { "type": "string", "enum": ["pending_ceo_review", "approved", "rejected", "revision_requested"] }
  },
  "additionalProperties": false
}
