{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://financex.io/schemas/agents/document_evidence/output",
  "title": "Document Evidence Agent Output Schema",
  "type": "object",
  "required": ["agent_id", "ticker", "claims", "claim_coverage", "confidence_overall"],
  "properties": {
    "agent_id": { "type": "string", "const": "document_evidence" },
    "ticker": { "type": "string" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "claim", "supporting_citations", "confidence"],
        "properties": {
          "claim_id": { "type": "string" },
          "claim": { "type": "string", "minLength": 10 },
          "topic": { "type": "string" },
          "supporting_citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["doc_id", "page", "snippet_excerpt"],
              "properties": {
                "doc_id": { "type": "string" },
                "page": { "type": "integer" },
                "snippet_excerpt": { "type": "string", "maxLength": 400 },
                "relevance": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "note": { "type": "string" }
        }
      }
    },
    "claim_coverage": {
      "type": "object",
      "required": ["total_claims"],
      "properties": {
        "total_claims": { "type": "integer", "minimum": 0 },
        "claims_per_priority_topic": { "type": "object" }
      }
    },
    "unanswered_questions": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "confidence_overall": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "BLOCKED"] }
  }
}
