{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://financex.io/schemas/agents/event_impact_mapper/output",
  "title": "Event Impact Mapper Agent Output Schema",
  "type": "object",
  "required": ["agent_id", "output_id", "session_id", "task_id", "timestamp", "company", "event_impacts", "confidence_overall", "warnings", "review_status"],
  "properties": {
    "agent_id": { "type": "string", "const": "event_impact_mapper" },
    "output_id": { "type": "string" },
    "session_id": { "type": "string" },
    "task_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "company": {
      "type": "object",
      "required": ["name", "ticker"],
      "properties": {
        "name": { "type": "string" },
        "ticker": { "type": "string" }
      }
    },
    "event_impacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "event_type", "affected_statements", "affected_line_items", "impact_direction", "timing_horizon", "confidence", "effect_type", "quantification_possible", "evidence_refs"],
        "properties": {
          "event_id": { "type": "string" },
          "event_type": {
            "type": "string",
            "enum": [
              "new_contract",
              "production_halt",
              "debt_issuance",
              "capex_decision",
              "legal_dispute",
              "management_change",
              "dividend_buyback",
              "asset_sale",
              "partnership_jv_acquisition",
              "regulatory_event"
            ]
          },
          "event_summary": { "type": "string" },
          "disclosure_reference": { "type": "string" },
          "disclosure_date": { "type": "string", "format": "date" },
          "affected_statements": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["income_statement", "balance_sheet", "cash_flow_statement", "statement_of_equity", "notes"]
            }
          },
          "affected_line_items": {
            "type": "array",
            "items": { "type": "string" }
          },
          "impact_direction": {
            "type": "string",
            "enum": ["positive", "negative", "uncertain", "mixed"]
          },
          "timing_horizon": {
            "type": "string",
            "enum": ["immediate", "near_term", "medium_term", "long_term"]
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "speculative"]
          },
          "effect_type": {
            "type": "string",
            "enum": ["confirmed", "plausible", "speculative"]
          },
          "quantification_possible": { "type": "boolean" },
          "quantification_notes": { "type": "string" },
          "quantification_estimate": {
            "type": ["object", "null"],
            "properties": {
              "metric": { "type": "string" },
              "value": { "type": "number" },
              "unit": { "type": "string" },
              "confidence": { "type": "string" },
              "formula_used": { "type": "string" },
              "inputs_used": { "type": "object" },
              "materiality_pct": { "type": "number" },
              "materiality_base": { "type": "string" }
            }
          },
          "secondary_effects": {
            "type": "array",
            "items": { "type": "string" }
          },
          "risks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence_refs": {
            "type": "array",
            "items": { "$ref": "https://financex.internal/schemas/shared/evidence.schema.json" }
          },
          "ifrs_standards_applied": {
            "type": "array",
            "items": { "type": "string" }
          },
          "warnings": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "portfolio_impact_summary": { "type": "string" },
    "high_urgency_events": {
      "type": "array",
      "items": { "type": "string" },
      "description": "event_ids that require immediate attention in the analysis"
    },
    "confidence_overall": {
      "type": "string",
      "enum": ["high", "medium", "low", "speculative"]
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "missing_inputs": { "type": "array", "items": { "type": "string" } },
    "contradictions_detected": { "type": "array", "items": { "type": "object" } },
    "review_status": {
      "type": "string",
      "enum": ["pending_ceo_review", "approved", "rejected", "revision_requested"]
    }
  },
  "additionalProperties": false
}
