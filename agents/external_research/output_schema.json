{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://financex.io/schemas/agents/external_research/output",
  "title": "External Research Agent Output Schema",
  "type": "object",
  "required": ["agent_id", "ticker", "scope_queries", "findings", "confidence_overall"],
  "properties": {
    "agent_id": { "type": "string", "const": "external_research" },
    "ticker": { "type": "string" },
    "scope_queries": { "type": "array", "items": { "type": "string" } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["query", "sources"],
        "properties": {
          "query": { "type": "string" },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url", "title"],
              "properties": {
                "url": { "type": "string" },
                "title": { "type": "string" },
                "publisher": { "type": "string" },
                "publication_date": { "type": "string" },
                "snippet": { "type": "string" },
                "credibility": { "type": "string", "enum": ["high", "medium", "low"] },
                "credibility_reason": { "type": "string" }
              }
            }
          },
          "synthesized_answer": { "type": "string" },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] }
        }
      }
    },
    "status": { "type": "string", "enum": ["active", "scaffold_stub", "disabled"] },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "confidence_overall": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "BLOCKED"] }
  }
}
