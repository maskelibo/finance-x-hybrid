{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://financex.io/schemas/agents/reconciliation/output",
  "title": "Reconciliation Agent Output Schema",
  "type": "object",
  "required": ["agent_id", "output_id", "session_id", "task_id", "timestamp", "company", "reconciled_data", "discrepancy_report", "confidence_overall", "warnings", "review_status"],
  "properties": {
    "agent_id": { "type": "string", "const": "reconciliation" },
    "output_id": { "type": "string" },
    "session_id": { "type": "string" },
    "task_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "company": { "type": "object" },
    "reconciled_data": {
      "type": "object",
      "description": "Authoritative reconciled financial statements ready for downstream analysis",
      "properties": {
        "ias29": {
          "type": "object",
          "description": "IAS 29 / TMS 29 reconciled block (inherits from parse_standardization). Net monetary position is excluded from EBITDA per operating-definition.",
          "properties": {
            "ias29_applied": { "type": "boolean" },
            "operating_profit_restated": { "type": ["number", "null"] },
            "depreciation_restated": { "type": ["number", "null"] },
            "amortization_restated": { "type": ["number", "null"] },
            "net_monetary_position_gain_loss": { "type": ["number", "null"] },
            "reported_ebitda": { "type": ["number", "null"] }
          }
        }
      }
    },
    "authoritative_source": { "type": "string" },
    "discrepancy_report": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["discrepancy_id", "metric", "source_a_value", "source_b_value", "discrepancy_magnitude_pct", "materiality", "resolution_status"],
        "properties": {
          "discrepancy_id": { "type": "string" },
          "metric": { "type": "string" },
          "source_a_id": { "type": "string" },
          "source_a_value": { "type": "number" },
          "source_a_quality_score": { "type": "number" },
          "source_b_id": { "type": "string" },
          "source_b_value": { "type": "number" },
          "source_b_quality_score": { "type": "number" },
          "discrepancy_magnitude_abs": { "type": "number" },
          "discrepancy_magnitude_pct": { "type": "number" },
          "materiality": { "type": "boolean" },
          "resolution_status": { "type": "string", "enum": ["resolved", "unresolved", "escalated"] },
          "resolution_method": { "type": "string", "enum": ["preferred_source", "rounding", "restatement", "rule_applied", "escalated", "not_applicable"] },
          "resolution_notes": { "type": "string" },
          "value_used_in_reconciled_data": { "type": "number" }
        }
      }
    },
    "unresolved_discrepancies": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "object" } },
    "confidence_overall": { "type": "string", "enum": ["high", "medium", "low", "speculative"] },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "missing_inputs": { "type": "array", "items": { "type": "string" } },
    "contradictions_detected": { "type": "array", "items": { "type": "object" } },
    "review_status": { "type": "string", "enum": ["pending_ceo_review", "approved", "rejected", "revision_requested"] }
  },
  "additionalProperties": false
}
