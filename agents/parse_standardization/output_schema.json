{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://financex.io/schemas/agents/parse_standardization/output",
  "title": "Parse & Standardization Agent Output Schema",
  "type": "object",
  "required": ["agent_id", "output_id", "session_id", "task_id", "timestamp", "company", "parsed_statements", "parsing_metadata", "confidence_overall", "warnings", "review_status"],
  "properties": {
    "agent_id": { "type": "string", "const": "parse_standardization" },
    "output_id": { "type": "string" },
    "session_id": { "type": "string" },
    "task_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "company": { "type": "object", "properties": { "name": { "type": "string" }, "ticker": { "type": "string" } } },
    "parsed_statements": {
      "type": "object",
      "properties": {
        "income_statement": { "$ref": "#/definitions/ParsedStatement" },
        "balance_sheet": { "$ref": "#/definitions/ParsedStatement" },
        "cash_flow_statement": { "$ref": "#/definitions/ParsedStatement" },
        "notes_extracted": { "$ref": "#/definitions/ParsedNotes" },
        "ias29": { "$ref": "#/definitions/Ias29Block" }
      }
    },
    "parsing_metadata": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_document_id", "source_line_item_original", "ifrs_mapping", "parser_confidence", "extraction_method"],
        "properties": {
          "source_document_id": { "type": "string" },
          "source_line_item_original": { "type": "string" },
          "ifrs_mapping": { "type": "string" },
          "parser_confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "extraction_method": { "type": "string", "enum": ["xbrl_direct", "pdf_structured_table", "pdf_unstructured", "html_table"] },
          "page_reference": { "type": "string" },
          "ambiguity_flag": { "type": "boolean" },
          "ambiguity_note": { "type": "string" }
        }
      }
    },
    "normalization_notes": { "type": "array", "items": { "type": "string" } },
    "restatement_flags": { "type": "array", "items": { "type": "object" } },
    "data_quality_issues": { "type": "array", "items": { "type": "string" } },
    "balance_sheet_balanced": { "type": "boolean" },
    "confidence_overall": { "type": "string", "enum": ["high", "medium", "low", "speculative"] },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "missing_inputs": { "type": "array", "items": { "type": "string" } },
    "review_status": { "type": "string", "enum": ["pending_ceo_review", "approved", "rejected", "revision_requested"] }
  },
  "additionalProperties": false,
  "definitions": {
    "ParsedStatement": {
      "type": "object",
      "properties": {
        "period": { "type": "string" },
        "currency": { "type": "string" },
        "scale": { "type": "string" },
        "line_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ifrs_label", "value", "parser_confidence"],
            "properties": {
              "ifrs_label": { "type": "string" },
              "original_label": { "type": "string" },
              "value": { "type": ["number", "null"] },
              "parser_confidence": { "type": "number" },
              "source_document_id": { "type": "string" },
              "page_ref": { "type": "string" }
            }
          }
        }
      }
    },
    "ParsedNotes": {
      "type": "object",
      "properties": {
        "accounting_policies": { "type": "string" },
        "segment_data": { "type": "object" },
        "contingent_liabilities": { "type": "array", "items": { "type": "object" } },
        "related_party_transactions": { "type": "array", "items": { "type": "object" } }
      }
    },
    "Ias29Block": {
      "type": "object",
      "description": "IAS 29 / TMS 29 hyperinflation accounting signals. Populate when Turkish IFRS filings mark statements as restated. Net monetary position is a non-operating item (excluded from EBITDA).",
      "properties": {
        "ias29_applied": { "type": "boolean", "description": "True when filing is inflation-adjusted per IAS 29." },
        "restatement_note_ref": { "type": "string", "description": "Note reference for inflation-accounting methodology (e.g., 'Not 2.1')." },
        "operating_profit_restated": { "type": ["number", "null"] },
        "depreciation_restated": { "type": ["number", "null"] },
        "amortization_restated": { "type": ["number", "null"] },
        "net_monetary_position_gain_loss": {
          "type": ["number", "null"],
          "description": "Net Parasal Pozisyon Kazanç/Kaybı (Note 35 typical). EXCLUDED from EBITDA."
        },
        "reported_ebitda": {
          "type": ["number", "null"],
          "description": "Management-disclosed EBITDA, if present. Used for reconciliation."
        }
      }
    }
  }
}
