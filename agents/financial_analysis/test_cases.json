          "current_liabilities": 28000,
          "operating_cf": 15200,
          "capex": 5800
        }
      },
      "expected_behavior": {
        "gross_margin_computed": 0.2536,
        "ebitda_margin_computed": 0.1943,
        "net_margin_computed": 0.1239,
        "current_ratio_computed": 1.607,
        "evidence_refs_present": true,
        "confidence_overall": "high"
      },
      "pass_criteria": [
        "Gross margin = 24161/95243 = 25.36% (within 0.1%)",
