    {
      "test_id": "fa-tc-003",
      "name": "IAS 29 inflation accounting flag — TCELL FY2023",
      "input": {
        "ticker": "TCELL",
        "period": "FY2023",
        "inflation_accounting_applied": true,
        "reconciled_data": {
          "revenue_reported": 125000,
          "revenue_restated": 98000,
          "net_income_reported": 18000,
          "net_income_restated": 9500
