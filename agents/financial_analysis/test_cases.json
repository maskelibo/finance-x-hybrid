      },
      "expected_behavior": {
        "inflation_accounting_applied_flag": true,
        "both_reported_and_restated_values_present": true,
        "analysis_uses_restated_values_primarily": true,
        "warning_about_ias29_present": true
      },
      "pass_criteria": [
        "Output notes that IAS 29 applies and explains impact",
        "Primary analysis uses restated (inflation-adjusted) figures",
        "Original reported values also presented for reference",
        "Warning: margins will differ materially from non-IAS29 peers"
      ],
      "fail_criteria": [
        "Only reported (unadjusted) values used without noting IAS 29",
        "No mention of inflation accounting impact",
        "Restated and reported values mixed without explanation"
