        "reconciled_data": {
          "revenue": 95243,
          "cogs": 71082,
          "gross_profit": 24161,
          "ebitda": 18500,
          "ebit": 14200,
          "net_income": 11800,
          "total_assets": 142000,
          "total_equity": 85000,
          "total_debt": 22000,
          "cash": 8500,
