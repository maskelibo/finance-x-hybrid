{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VAL DCF Assumptions Output",
  "description": "Deterministic Python output: WACC components + terminal growth. ≤2KB target.",
  "type": "object",
  "required": ["ticker", "wacc_components", "terminal_growth_pct", "data_gaps"],
  "properties": {
    "ticker": { "type": "string" },
    "sector": { "type": ["string", "null"] },
    "wacc_components": {
      "type": "object",
      "required": ["risk_free_rate_pct", "beta", "equity_risk_premium_pct", "cost_of_equity_pct", "cost_of_debt_pre_tax_pct", "tax_rate_pct", "cost_of_debt_after_tax_pct", "equity_weight_pct", "debt_weight_pct", "wacc_pct"],
      "properties": {
        "risk_free_rate_pct":         { "type": "number" },
        "beta":                       { "type": "number" },
        "equity_risk_premium_pct":    { "type": "number" },
        "cost_of_equity_pct":         { "type": "number" },
        "cost_of_debt_pre_tax_pct":   { "type": "number" },
        "tax_rate_pct":               { "type": "number" },
        "cost_of_debt_after_tax_pct": { "type": "number" },
        "equity_weight_pct":          { "type": "number" },
        "debt_weight_pct":            { "type": "number" },
        "wacc_pct":                   { "type": "number" }
      }
    },
    "terminal_growth_pct": { "type": "number" },
    "data_quality": {
      "type": "object",
      "properties": {
        "fa_available":                       { "type": "boolean" },
        "macro_available":                    { "type": "boolean" },
        "fa_canonical_numbers_populated":     { "type": "boolean" }
      }
    },
    "data_gaps": { "type": "array", "items": { "type": "string" } }
  }
}
