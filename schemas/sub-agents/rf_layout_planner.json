{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RF Layout Planner Output",
  "type": "object",
  "required": ["ticker", "sections"],
  "properties": {
    "ticker": { "type": "string" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "order"],
        "properties": {
          "id":    { "type": "string" },
          "title": { "type": "string" },
          "order": { "type": "integer", "minimum": 0 }
        }
      },
      "minItems": 14
    }
  }
}
