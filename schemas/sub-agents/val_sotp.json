{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VAL Sum-of-the-Parts Output",
  "type": "object",
  "required": ["ticker", "applicable", "segments", "data_gaps"],
  "properties": {
    "ticker":       { "type": "string" },
    "applicable":   { "type": "boolean" },
    "reason":       { "type": "string" },
    "segments":     { "type": "array" },
    "holding_net_debt_try_mn":     { "type": ["number", "null"] },
    "nav_try_mn":                  { "type": ["number", "null"] },
    "current_market_cap_try_mn":   { "type": ["number", "null"] },
    "implied_holding_discount_pct":{ "type": ["number", "null"] },
    "historical_holding_discount_pct": { "type": ["object", "null"] },
    "interpretation":              { "type": "string" },
    "applied_target_price_try":    { "type": ["number", "null"] },
    "data_gaps":                   { "type": "array" }
  }
}
