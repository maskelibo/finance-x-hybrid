{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MA Geopolitical Risk Output",
  "type": "object",
  "required": ["as_of_date", "risks", "summary"],
  "properties": {
    "as_of_date": { "type": "string" },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "transmission", "severity"],
        "properties": {
          "name":         { "type": "string" },
          "description":  { "type": "string" },
          "transmission": { "type": "string" },
          "severity":     { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "sources":      { "type": "array" }
        }
      },
      "minItems": 1
    },
    "summary":   { "type": "string" },
    "data_gaps": { "type": "array" }
  }
}
