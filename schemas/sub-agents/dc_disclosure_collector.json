{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DC Disclosure Collector Output",
  "type": "object",
  "required": ["ticker", "disclosures", "total_count", "material_count"],
  "properties": {
    "ticker":          { "type": "string", "pattern": "^[A-Z]{3,6}$" },
    "disclosures":     {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date", "title", "type", "is_material"],
        "properties": {
          "id":              { "type": "string" },
          "date":            { "type": "string" },
          "title":           { "type": "string" },
          "type":            { "type": "string", "enum": ["material_event", "financial_statement", "board_decision", "other"] },
          "is_material":     { "type": "boolean" },
          "summary_extract": { "type": "string", "maxLength": 400 }
        }
      }
    },
    "total_count":     { "type": "integer", "minimum": 0 },
    "material_count":  { "type": "integer", "minimum": 0 },
    "rate_limit_hits": { "type": "integer", "minimum": 0 }
  }
}
