{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DC Reference Documents Collector Output",
  "type": "object",
  "required": ["ticker", "documents", "missing_doc_types"],
  "properties": {
    "ticker":    { "type": "string", "pattern": "^[A-Z]{3,6}$" },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "fiscal_year", "source_url"],
        "properties": {
          "type":                   { "type": "string", "enum": ["annual_report", "ir_presentation", "sustainability_report", "governance_report"] },
          "fiscal_year":            { "type": "string" },
          "language":               { "type": "string", "enum": ["tr", "en"] },
          "source_url":             { "type": "string" },
          "local_path":             { "type": "string" },
          "page_count":             { "type": "integer", "minimum": 0 },
          "document_intel_indexed": { "type": "boolean" }
        }
      }
    },
    "missing_doc_types": { "type": "array", "items": { "type": "string" } }
  }
}
