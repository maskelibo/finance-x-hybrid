{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FS Disclosure Guard Output",
  "type": "object",
  "required": ["ticker", "mandatory_disclosures", "disclaimers", "ethical_notes", "compliance_status"],
  "properties": {
    "ticker": { "type": "string" },

    "mandatory_disclosures": {
      "type": "array",
      "description": "SPK / KAP zorunlu material disclosure listesi (event'lerden çıkarılır).",
      "items": {
        "type": "object",
        "required": ["disclosure_type", "subject", "regulatory_basis"],
        "properties": {
          "disclosure_type":   { "type": "string", "enum": ["material_event", "annual_filing", "interim_filing", "shareholder_meeting", "tender_offer", "insider_transaction", "other"] },
          "subject":           { "type": "string", "maxLength": 200 },
          "event_id":          { "type": ["string", "null"] },
          "regulatory_basis":  { "type": "string", "description": "Örn: SPK Tebliği VII-128.1, KAP 2.1.3" }
        }
      }
    },

    "disclaimers": {
      "type": "array",
      "description": "Yasal disclaimer'lar — sabit metin set'i.",
      "items": {
        "type": "object",
        "required": ["category", "text"],
        "properties": {
          "category": { "type": "string", "enum": ["spk_general", "investment_advice", "data_source", "forward_looking", "ethical_use", "translation"] },
          "text":     { "type": "string", "maxLength": 600 }
        }
      }
    },

    "ethical_notes": {
      "type": "array",
      "description": "Etik notlar — örn. çıkar çatışması, model sınırlamaları, hallucination uyarısı.",
      "items": { "type": "string", "maxLength": 300 }
    },

    "compliance_status": {
      "type": "object",
      "required": ["all_mandatory_present", "missing_disclosures"],
      "properties": {
        "all_mandatory_present": { "type": "boolean" },
        "missing_disclosures":   { "type": "array", "items": { "type": "string" } },
        "warnings":              { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
