{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SC Peer Set Mapper Output",
  "type": "object",
  "required": ["ticker", "sector_canonical", "peer_set", "rationale"],
  "properties": {
    "ticker":           { "type": "string" },
    "sector_canonical": { "type": "string" },
    "sector_source":    { "type": "string", "enum": ["registry", "inferred"] },
    "is_holding":       { "type": "boolean" },
    "segments": {
      "type": "array",
      "description": "Holding sector için segment listesi (otomotiv, enerji, finans, gıda, ...). Holding değilse boş.",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name":            { "type": "string" },
          "revenue_share_pct": { "type": ["number", "null"] },
          "primary_subsidiaries": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "peer_set": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ticker"],
        "properties": {
          "ticker":      { "type": "string" },
          "name":        { "type": "string" },
          "rationale":   { "type": "string" },
          "segment":     { "type": ["string", "null"] }
        }
      }
    },
    "rationale":  { "type": "string" },
    "data_gaps":  { "type": "array", "items": { "type": "string" } }
  }
}
