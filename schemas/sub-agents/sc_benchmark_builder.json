{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SC Benchmark Quartile Builder Output",
  "type": "object",
  "required": ["ticker", "scope", "metrics", "ranking"],
  "properties": {
    "ticker":  { "type": "string" },
    "scope": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type":    { "type": "string", "enum": ["consolidated", "segment"] },
        "segment": { "type": ["string", "null"] },
        "peer_count": { "type": ["integer", "null"] }
      }
    },
    "metrics": {
      "type": "object",
      "description": "Per-metric quartile table (gross_margin, ebitda_margin, net_margin, roe, roa, ev_ebitda, p_e, net_debt_ebitda).",
      "additionalProperties": { "$ref": "#/definitions/QuartileEntry" }
    },
    "ranking": {
      "type": "object",
      "required": ["overall_quartile"],
      "properties": {
        "overall_quartile": { "type": "integer", "minimum": 1, "maximum": 4 },
        "strengths":  { "type": "array", "items": { "type": "string" } },
        "weaknesses": { "type": "array", "items": { "type": "string" } }
      }
    },
    "narrative":  { "type": "string", "maxLength": 800 },
    "data_gaps":  { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "QuartileEntry": {
      "type": "object",
      "required": ["company_value", "peer_quartiles", "quartile_rank"],
      "properties": {
        "company_value":  { "type": ["number", "null"] },
        "peer_quartiles": {
          "type": "object",
          "properties": {
            "q1":     { "type": ["number", "null"] },
            "median": { "type": ["number", "null"] },
            "q3":     { "type": ["number", "null"] }
          }
        },
        "quartile_rank":  { "type": ["integer", "null"], "minimum": 1, "maximum": 4 },
        "unit":           { "type": "string" }
      }
    }
  }
}
